#include <winuser.h>
#include "../src/version.h"
1 ICON "app.ico"
1 RT_MANIFEST "app.manifest"
ICON_PLAY RCDATA "icon_play.png"
ICON_PAUSE RCDATA "icon_pause.png"
ICON_PREV RCDATA "icon_prev.png"
ICON_NEXT RCDATA "icon_next.png"
ICON_OPEN RCDATA "icon_open.png"
ICON_INFO RCDATA "icon_info.png"
ICON_EQ RCDATA "icon_eq.png"
ICON_VISUALIZER RCDATA "icon_visualizer.png"
ICON_MUTE_OFF RCDATA "icon_mute_off.png"
ICON_MUTE_ON RCDATA "icon_mute_on.png"
ICON_REPEAT_OFF RCDATA "icon_repeat_off.png"
ICON_REPEAT_OFF_FOLDER RCDATA "icon_repeat_off_folder.png"
ICON_FULLSCREEN RCDATA "icon_fullscreen.png"
ICON_REPEAT_ALL RCDATA "icon_repeat_all.png"
ICON_REPEAT_ONE RCDATA "icon_repeat_one.png"
ICON_COVER RCDATA "icon_cover.png"

1 VERSIONINFO
FILEVERSION TLAP_VER_MAJOR,TLAP_VER_MINOR,TLAP_VER_PATCH,0
PRODUCTVERSION TLAP_VER_MAJOR,TLAP_VER_MINOR,TLAP_VER_PATCH,0
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904B0"
    BEGIN
      VALUE "FileDescription", "Tenokun's Light Audio Player"
      VALUE "ProductName", "Tenokun's Light Audio Player"
      VALUE "ProductVersion", TLAP_VER_STR
      VALUE "FileVersion", TLAP_VER_STR
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x409, 1200
  END
END
